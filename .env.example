# Configuracion del MySQL local administrado por PHPMyAdmin (MAMP: puerto 8889)
DB_HOST=localhost
DB_PORT=8889
DB_USER=root
DB_PASSWORD=root
DB_NAME=resultados_tandil

# Secreto del endpoint de revalidacion on-demand (POST /api/revalidate).
# Generar uno fuerte en produccion: openssl rand -hex 32
ISR_SECRET=

# --- Cuadro de preguntas en lenguaje natural (feature 002) ---
# Clave del servicio externo de interpretacion (OpenAI). SOLO se usa en el servidor,
# nunca llega al navegador ni al repo.
LLM_API_KEY=

# Modelo del servicio de interpretacion (clase mini compatible con structured outputs).
LLM_MODEL=gpt-4o-mini

# Modo del interprete: "live" (produccion) o "mock" (tests/desarrollo sin gasto ni red).
ASK_INTERPRETER_MODE=live

# Lazo de ritmo por visitante (direccion de red): max preguntas en la ventana.
ASK_RATE_LIMIT_MAX=10
ASK_RATE_LIMIT_WINDOW_MS=60000

# Memoria temporal de respuestas: vigencia (TTL) y cantidad maxima de entradas (LRU).
ASK_CACHE_TTL_MS=600000
ASK_CACHE_MAX_ENTRIES=200
