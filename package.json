{
  "name": "resultados-tandil",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma pública de consulta de resultados electorales locales de Tandil",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
